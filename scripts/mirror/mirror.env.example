# /etc/safetravel/mirror.env — settings for safetravel-sync.sh (docs/MIRROR.md). Shell syntax: NAME=value.
# Every line is optional; the defaults are shown.

# Where the site comes from. GitHub Actions is the only process that fetches from Taiwan CDC, MOFA, TDX and CWA;
# this machine only copies the result.
#REPO_URL=https://github.com/ancientsky/safetravel.git
#BRANCH=main
#SITE_URL=https://ancientsky.github.io/safetravel      # live site: the source of data/arrivals.json

# Outbound proxy, if this network reaches the internet through one (used by git and curl).
#HTTPS_PROXY=http://proxy.example.internal:8080
#NO_PROXY=localhost,127.0.0.1

# Layout and housekeeping.
#BASE=/srv/safetravel            # repo/, releases/, www/ (nginx root), state/, tmp/
#KEEP_RELEASES=12                # releases kept for --rollback (unchanged files are hard links: little disk)
#HTTP_TIMEOUT=60                 # seconds per download

# --check thresholds (monitoring).
#WARN_AFTER_MIN=30               # last successful sync older than this -> WARNING
#CRIT_AFTER_MIN=120              #                                      -> CRITICAL
#DATA_WARN_HOURS=26              # data/meta.json older than this -> WARNING (the upstream update has stalled)
