# /etc/systemd/system/safetravel-sync.service — one sync of the SafeTravel intranet mirror (docs/MIRROR.md).
# Started every 5 minutes by safetravel-sync.timer; run by hand with: systemctl start safetravel-sync.service
[Unit]
Description=SafeTravel TW intranet mirror: copy the published site from GitHub
Documentation=https://github.com/ancientsky/safetravel/blob/main/docs/MIRROR.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=safetravel
Group=safetravel
Environment=HOME=/srv/safetravel
ExecStart=/opt/safetravel/safetravel-sync.sh
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
# hardening: the script only writes under /srv/safetravel
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/safetravel
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
